---
// src/components/ui/FloatingThemeToggle.astro
// Botón flotante desacoplado para alternar tema Dark/Light
import { AnimatedThemeToggler } from '@/components/ui/animated-theme-toggler';
---

<aside class="fixed top-5 right-16 z-50 pointer-events-auto" aria-label="Control de tema">
    <AnimatedThemeToggler
      client:load
      variant="square"
      className="w-10 h-10 flex items-center justify-center rounded-xl bg-transparent border-0 hover:bg-white/10 dark:hover:bg-white/10 light:hover:bg-slate-200/70 transition-colors cursor-pointer"
    />
</aside>
